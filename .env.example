# Copia este archivo a .env y reemplaza los valores antes de levantar el proyecto
# nunca subas el archivo .env real a git (ya está en .gitignore)

# --- Base de datos ---
POSTGRES_USER=sentinela
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=sentinela
DATABASE_URL=postgresql://sentinela:cambia-esta-contrasena@postgres:5432/sentinela

# --- Redis / colas ---
REDIS_URL=redis://redis:6379

# --- Seguridad ---
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=reemplaza-esto-con-una-cadena-aleatoria-larga
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Entorno ---
ENVIRONMENT=development
